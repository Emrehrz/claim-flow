{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=claimflow;Username=claimflow;Password=claimflow123"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "ClaimFlow.API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "SuperSecretKeyThatIsAtLeast32CharactersLong!",
    "ExpiryMinutes": 60,
    "Issuer": "ClaimFlowAPI",
    "Audience": "ClaimFlowClients"
  }
}